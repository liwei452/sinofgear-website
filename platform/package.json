{
  "name": "ai-export-workbench-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "concurrently -n api,workbench -c blue,green \"pnpm --filter @workbench/api dev\" \"pnpm --filter @workbench/web dev\"",
