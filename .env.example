VITE_SITE_URL=https://sinofgears.com
VITE_VISITOR_COUNTRY_CODE=
VITE_GEO_API_URL=
VITE_CUSTOMER_SERVICE_ENABLED=false
VITE_CUSTOMER_SERVICE_SDK_URL=https://static.t.venorzom.com/loader.js
VITE_CUSTOMER_SERVICE_SITE_KEY=
VITE_CUSTOMER_SERVICE_ENDPOINT=https://apigw.t.venorzom.com/
VITE_CUSTOMER_SERVICE_LOCALE=en
INQUIRY_TO_EMAIL=admin@sinofgears.onmicrosoft.com
INQUIRY_FROM_EMAIL=Sinoform RFQ <inquiries@sinofgears.com>
# Set RESEND_API_KEY as an encrypted Cloudflare secret. Do not save it here.
# Growth Engine blog publishing (Cloudflare Pages server-side variables/secrets)
GROWTH_ORGANIZATION_ID=
GITHUB_REPOSITORY=liwei452/sinofgear-website
GITHUB_BRANCH=master
# Bind BLOG_PREVIEWS to a Cloudflare KV namespace.
# Store GROWTH_PUBLISH_TOKEN and GITHUB_CONTENT_TOKEN as encrypted secrets.
# Bind GROWTH_ASSETS to an R2 bucket for reviewed article cover bytes.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=sinoform
# Store CLOUDFLARE_API_TOKEN as an encrypted Pages secret.
